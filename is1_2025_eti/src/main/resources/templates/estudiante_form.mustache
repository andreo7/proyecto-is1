<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dar de alta estudiante</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Dar de alta estudiante</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block font-semibold mb-2">{{successMessage}}</span>
            <div class="flex gap-3 mt-2">
                <a href="/student/new"
                   class="bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700 text-sm">
                    Crear otro estudiante
                </a>
                <a href="/dashboard"
                   class="bg-gray-600 text-white px-3 py-1 rounded hover:bg-gray-700 text-sm">
                    Volver al panel
                </a>
            </div>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block font-semibold mb-2">{{errorMessage}}</span>
            <div class="flex gap-3 mt-2">
                <a href="/student/new"
                   class="bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700 text-sm">
                    Intentar de nuevo
                </a>
                <a href="/dashboard"
                   class="bg-gray-600 text-white px-3 py-1 rounded hover:bg-gray-700 text-sm">
                    Volver al panel
                </a>
            </div>
        </div>
        {{/errorMessage}}

        <form action="/student/new" method="post" class="space-y-4">
            <div>
                <label for="nombre" class="block text-gray-700 text-sm font-medium mb-1">Nombre:</label>
                <input type="text" id="nombre" name="nombre" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="apellido" class="block text-gray-700 text-sm font-medium mb-1">Apellido:</label>
                <input type="text" id="apellido" name="apellido" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="dni" class="block text-gray-700 text-sm font-medium mb-1">DNI:</label>
                <input type="number" id="dni" name="dni" required min="1"
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="contacto" class="block text-gray-700 text-sm font-medium mb-1">Email de contacto:</label>
                <input type="email" id="contacto" name="contacto" required
                       placeholder="ejemplo@dominio.com"
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="direccion" class="block text-gray-700 text-sm font-medium mb-1">Dirección:</label>
                <input type="text" id="direccion" name="direccion" required
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="nroAlumno" class="block text-gray-700 text-sm font-medium mb-1">Número de alumno:</label>
                <input type="number" id="nroAlumno" name="nroAlumno" required min="1"
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            <div>
                <label for="estadoCarrera" class="block text-gray-700 text-sm font-medium mb-1">Estado de carrera:</label>
                <select id="estadoCarrera" name="estadoCarrera" required
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                    <option value="" disabled selected>Seleccionar estado...</option>
                    <option value="Ingresante">Ingresante</option>
                    <option value="Avanzado">Avanzado</option>
                </select>
            </div>
            <button type="submit"
                    class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                Dar de alta Estudiante
            </button>
            <div class="text-center mt-4">
                <a href="/students" class="text-blue-600 hover:underline text-sm">Ver listado de estudiantes</a>
            </div>
            <div class="text-center">
                <a href="/dashboard" class="text-blue-600 hover:underline text-sm">Volver al panel</a>
            </div>
        </form>
    </div>
</body>
</html>
