<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dar de alta carrera</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
<div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
    <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Dar de alta carrera</h1>

    {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
            <span class="block font-semibold mb-2">{{successMessage}}</span>
            <div class="flex gap-3 mt-2">
                <a href="/carrera/new"
                   class="bg-green-600 text-white px-3 py-1 rounded hover:bg-green-700 text-sm">
                    Crear otra carrera
                </a>
                <a href="/dashboard"
                   class="bg-gray-600 text-white px-3 py-1 rounded hover:bg-gray-700 text-sm">
                    Volver al panel
                </a>
            </div>
        </div>
    {{/successMessage}}

    {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
            <span class="block font-semibold mb-2">{{errorMessage}}</span>
            <div class="flex gap-3 mt-2">
                <a href="/carrera/new"
                   class="bg-red-600 text-white px-3 py-1 rounded hover:bg-red-700 text-sm">
                    Intentar de nuevo
                </a>
                <a href="/dashboard"
                   class="bg-gray-600 text-white px-3 py-1 rounded hover:bg-gray-700 text-sm">
                    Volver al panel
                </a>
            </div>
        </div>
    {{/errorMessage}}

    <form action="/carrera/new" method="post" class="space-y-4">
        <div>
            <label for="nombre" class="block text-gray-700 text-sm font-medium mb-1">Nombre:</label>
            <input type="text" id="nombre" name="nombre" required
                   class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                   placeholder="Ej: Ingeniería en Sistemas">
        </div>
        <div>
            <label for="descripcion" class="block text-gray-700 text-sm font-medium mb-1">Descripción:</label>
            <textarea id="descripcion" name="descripcion" required rows="3"
                      class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                      placeholder="Descripción de la carrera"></textarea>
        </div>
        <div>
            <label for="codigo" class="block text-gray-700 text-sm font-medium mb-1">Código:</label>
            <input type="number" id="codigo" name="codigo" required min="1"
                   class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-indigo-500"
                   placeholder="Ej: 101">
        </div>
        <button type="submit"
                class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2">
            Dar de alta Carrera
        </button>
        <div class="text-center mt-4">
            <a href="/carrera/list" class="text-indigo-600 hover:underline text-sm">Ver listado de carreras</a>
        </div>
        <div class="text-center">
            <a href="/dashboard" class="text-indigo-600 hover:underline text-sm">Volver al panel</a>
        </div>
    </form>
</div>
</body>
</html>
