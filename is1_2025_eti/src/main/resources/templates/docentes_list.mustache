<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Listado de Docentes</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-6">
    <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-lg shadow-lg p-8">
           <div class="flex items-center justify-center gap-2">
               <a href="/teacher/{{id}}/materias"
                  class="bg-orange-100 text-orange-700 hover:bg-orange-200 px-3 py-1 rounded text-xs font-medium transition duration-150">
                   Materias
               </a>
               <a href="/teacher/{{id}}/edit"
                  class="bg-yellow-100 text-yellow-700 hover:bg-yellow-200 px-3 py-1 rounded text-xs font-medium transition duration-150">
                   Editar
               </a>
               <form action="/teacher/{{id}}/delete" method="post" class="inline"
                     onsubmit="return confirm('¿Está seguro de que desea eliminar al docente {{nombre}} {{apellido}}? Esta acción no se puede deshacer.');">
                   <button type="submit"
                           class="bg-red-100 text-red-700 hover:bg-red-200 px-3 py-1 rounded text-xs font-medium transition duration-150">
                       Eliminar
                   </button>
               </form>
           </div>

            {{#successMessage}}
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4">
                <span class="block font-semibold">{{successMessage}}</span>
            </div>
            {{/successMessage}}

            {{#errorMessage}}
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4">
                <span class="block font-semibold">{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            <div class="overflow-x-auto">
                <table class="w-full text-sm text-left text-gray-700 border border-gray-200 rounded-lg overflow-hidden">
                    <thead class="bg-gray-50 text-gray-600 uppercase text-xs font-semibold">
                        <tr>
                            <th class="px-4 py-3 border-b">Nombre</th>
                            <th class="px-4 py-3 border-b">Apellido</th>
                            <th class="px-4 py-3 border-b">DNI</th>
                            <th class="px-4 py-3 border-b">Contacto</th>
                            <th class="px-4 py-3 border-b">Dirección</th>
                            <th class="px-4 py-3 border-b">Matrícula</th>
                            <th class="px-4 py-3 border-b text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        {{#docentes}}
                        <tr class="hover:bg-gray-50 transition-colors">
                            <td class="px-4 py-3">{{nombre}}</td>
                            <td class="px-4 py-3">{{apellido}}</td>
                            <td class="px-4 py-3">{{dni}}</td>
                            <td class="px-4 py-3">{{contacto}}</td>
                            <td class="px-4 py-3">{{direccion}}</td>
                            <td class="px-4 py-3">{{matricula}}</td>
                            <td class="px-4 py-3 text-center">
                                <div class="flex items-center justify-center gap-2">
                                    <a href="/teacher/{{id}}/edit"
                                       class="bg-yellow-100 text-yellow-700 hover:bg-yellow-200 px-3 py-1 rounded text-xs font-medium transition duration-150">
                                        Editar
                                    </a>
                                    <form action="/teacher/{{id}}/delete" method="post" class="inline"
                                          onsubmit="return confirm('¿Está seguro de que desea eliminar al docente {{nombre}} {{apellido}}? Esta acción no se puede deshacer.');">
                                        <button type="submit"
                                                class="bg-red-100 text-red-700 hover:bg-red-200 px-3 py-1 rounded text-xs font-medium transition duration-150">
                                            Eliminar
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        {{/docentes}}

                        {{^docentes}}
                        <tr>
                            <td colspan="7" class="px-6 py-12 text-center text-gray-400 text-sm">
                                No hay docentes registrados aún.
                                <a href="/teacher/new" class="text-blue-600 hover:underline ml-1">Dar de alta el primero</a>.
                            </td>
                        </tr>
                        {{/docentes}}
                    </tbody>
                </table>
            </div>

            <div class="text-center mt-6">
                <a href="/dashboard" class="text-blue-600 hover:underline text-sm">Volver al panel de control</a>
            </div>
        </div>
    </div>
</body>
</html>
